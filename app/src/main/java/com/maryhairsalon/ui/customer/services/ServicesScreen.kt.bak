package com.maryhairsalon.customer.ui.services

import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.grid.GridCells
import androidx.compose.foundation.lazy.grid.LazyVerticalGrid
import androidx.compose.foundation.lazy.grid.items
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.automirrored.filled.ArrowBack
import androidx.compose.material.icons.filled.Clear
import androidx.compose.material.icons.filled.Search
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.layout.ContentScale
import androidx.compose.ui.unit.dp
import androidx.lifecycle.compose.collectAsStateWithLifecycle
import androidx.lifecycle.viewmodel.compose.viewModel
import coil.compose.AsyncImage
import com.maryhairsalon.customer.data.Category
import com.maryhairsalon.customer.data.Service

@Composable
fun ServicesScreen(
    viewModel: ServicesViewModel = viewModel(),
    onBookNow: (Service) -> Unit
) {
    val uiState by viewModel.uiState.collectAsStateWithLifecycle()

    Column(modifier = Modifier.fillMaxSize()) {

        OutlinedTextField(
            value = uiState.searchQuery,
            onValueChange = viewModel::setSearchQuery,
            placeholder = { Text("Search services or styles...") },
            leadingIcon = { Icon(Icons.Default.Search, contentDescription = null) },
            trailingIcon = {
                if (uiState.searchQuery.isNotEmpty()) {
                    IconButton(onClick = { viewModel.setSearchQuery("") }) {
                        Icon(Icons.Default.Clear, contentDescription = "Clear search")
                    }
                }
            },
            singleLine = true,
            modifier = Modifier.fillMaxWidth().padding(16.dp)
        )

        when {
            uiState.isLoading -> Box(Modifier.fillMaxSize(), Alignment.Center) {
                CircularProgressIndicator()
            }
            uiState.errorMessage != null -> Box(Modifier.fillMaxSize(), Alignment.Center) {
                Text(uiState.errorMessage!!)
            }
            uiState.view == CatalogView.SEARCH -> {
                val results = viewModel.searchResults
                if (results.isEmpty()) {
                    Box(Modifier.fillMaxSize(), Alignment.Center) {
                        Text("No services match your search — try a different term.")
                    }
                } else {
                    ServiceList(services = results, onBookNow = onBookNow)
                }
            }
            uiState.view == CatalogView.CATEGORY_DETAIL -> {
                val category = viewModel.selectedCategory
                Row(
                    modifier = Modifier.padding(horizontal = 16.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    IconButton(onClick = viewModel::backToCategories) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "All categories")
                    }
                    Text(category?.label ?: "", style = MaterialTheme.typography.titleLarge)
                }
                Spacer(Modifier.height(8.dp))
                ServiceList(services = viewModel.selectedCategoryServices, onBookNow = onBookNow)
            }
            else -> CategoryGrid(categories = uiState.categories, onCategoryClick = viewModel::openCategory)
        }
    }
}

@Composable
private fun CategoryGrid(categories: List<Category>, onCategoryClick: (String) -> Unit) {
    LazyVerticalGrid(
        columns = GridCells.Adaptive(minSize = 160.dp),
        contentPadding = PaddingValues(16.dp),
        horizontalArrangement = Arrangement.spacedBy(12.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        items(categories, key = { it.id }) { category ->
            ElevatedCard(
                onClick = { onCategoryClick(category.id) },
                modifier = Modifier.fillMaxWidth()
            ) {
                Column {
                    AsyncImage(
                        model = category.image,
                        contentDescription = category.label,
                        contentScale = ContentScale.Crop,
                        modifier = Modifier.fillMaxWidth().height(100.dp)
                    )
                    Column(Modifier.padding(12.dp)) {
                        Text(category.label, style = MaterialTheme.typography.titleMedium)
                        if (category.desc.isNotBlank()) {
                            Text(category.desc, style = MaterialTheme.typography.bodySmall, maxLines = 2)
                        }
                        Spacer(Modifier.height(4.dp))
                        Text(
                            "${category.count} service${if (category.count == 1) "" else "s"}",
                            style = MaterialTheme.typography.labelSmall,
                            color = MaterialTheme.colorScheme.primary
                        )
                    }
                }
            }
        }
    }
}

@Composable
private fun ServiceList(services: List<Service>, onBookNow: (Service) -> Unit) {
    LazyColumn(
        contentPadding = PaddingValues(16.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        items(services, key = { it.id }) { service ->
            ElevatedCard(modifier = Modifier.fillMaxWidth()) {
                Row(Modifier.padding(12.dp)) {
                    AsyncImage(
                        model = service.image,
                        contentDescription = service.title,
                        contentScale = ContentScale.Crop,
                        modifier = Modifier.size(80.dp)
                    )
                    Spacer(Modifier.width(12.dp))
                    Column(Modifier.weight(1f)) {
                        Text(service.title, style = MaterialTheme.typography.titleMedium)
                        if (service.description.isNotBlank()) {
                            Text(
                                service.description,
                                style = MaterialTheme.typography.bodySmall,
                                maxLines = 2
                            )
                        }
                        if (service.tags.isNotEmpty()) {
                            Text(
                                service.tags.joinToString(" · "),
                                style = MaterialTheme.typography.labelSmall,
                                color = MaterialTheme.colorScheme.primary
                            )
                        }
                        Spacer(Modifier.height(6.dp))
                        Row(
                            modifier = Modifier.fillMaxWidth(),
                            horizontalArrangement = Arrangement.SpaceBetween,
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Text(service.price, style = MaterialTheme.typography.titleSmall)
                            Button(onClick = { onBookNow(service) }) { Text("Book Now") }
                        }
                    }
                }
            }
        }
    }
}